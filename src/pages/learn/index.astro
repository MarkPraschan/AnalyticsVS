---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLearnFeedItems } from '../../lib/learn';
import { formatCategory, formatMonthYear } from '../../lib/site';

const items = await getLearnFeedItems();
---

<BaseLayout
  title="Learn Analytics Concepts"
  description="Educational primers, how-tos, and buying guides for analytics — then follow through to comparisons, tool profiles, and the pricing calculator."
>
  <div class="page-shell">
    <header class="prose-width mb-10">
      <h1 class="section-heading text-gradient-primary">Learn</h1>
      <p class="page-intro mt-4">
        Short explainers, how-tos, and buying guides for analytics. Learn the vocabulary here, then
        use our{' '}
        <a href="/compare/">comparisons</a> and <a href="/tools/">tool profiles</a> when you are ready
        to choose.
      </p>
    </header>

    {
      items.length === 0 ? (
        <p class="text-sm text-muted" role="status">
          No Learn articles published yet.
        </p>
      ) : (
        <ul role="list" class="grid gap-8">
          {items.map((item) => (
            <li>
              <a
                href={item.href}
                class="card flex min-h-36 items-stretch overflow-hidden p-0 no-underline transition hover:border-indigo/40"
              >
                {
                  item.featuredImage ? (
                    <span class="relative w-36 shrink-0 self-stretch sm:w-56 md:w-72">
                      <img
                        src={item.featuredImage}
                        alt=""
                        width="1024"
                        height="571"
                        class="absolute inset-0 size-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  ) : null
                }
                <div class="flex flex-1 flex-col justify-center p-6">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="label-mono text-gradient-secondary">{formatCategory(item.category)}</p>
                    <p class="text-xs text-indigo-700">
                      <time datetime={item.date}>{formatMonthYear(item.date)}</time>
                    </p>
                  </div>
                  <h2 class="mt-2 font-heading text-xl font-semibold text-fg">{item.title}</h2>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
