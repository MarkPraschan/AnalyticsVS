---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BenchmarkCard from '../../components/BenchmarkCard.astro';
import { getPublishedBenchmarks } from '../../lib/benchmarks';

const recorded = await getPublishedBenchmarks();
const hasRecorded = recorded.length > 0;
---

<BaseLayout
  title="Script Performance Benchmarks"
  description="Recorded analytics script performance benchmarks measured under controlled conditions. Transfer size, decoded weight, and main-thread impact — never estimated numbers."
>
  <div class="page-shell">
    <header class="prose-width mb-10">
      <h1 class="section-heading text-gradient-primary">Benchmarks</h1>
      <p class="page-intro mt-4">
        {
          hasRecorded
            ? 'Real script performance measurements recorded by AnalyticsVS under controlled conditions. We never publish estimated, scraped, or AI-generated benchmark data.'
            : 'We are building a library of recorded analytics script benchmarks — measured on real test pages, not estimated from marketing claims.'
        }
      </p>
      <p class="mt-4 text-sm">
        <a href="/methodology/">Read our benchmark methodology →</a>
      </p>
    </header>

    {
      !hasRecorded && (
        <section class="prose-width mb-10" aria-labelledby="benchmarks-coming-soon">
          <div class="card border-dashed">
            <p class="label-mono text-gradient-secondary">Coming soon</p>
            <h2 id="benchmarks-coming-soon" class="mt-3 font-heading text-xl font-semibold text-fg">
              Recorded script performance data
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted">
              Most analytics comparisons repeat vendor claims about script weight. We are recording
              our own numbers instead — transfer size, decoded body size, and main-thread blocking
              time on controlled test pages with documented network and device conditions.
            </p>
            <p class="mt-4 text-base leading-relaxed text-muted">
              We will not publish a benchmark until a test is complete.
            </p>
            <ul class="mt-5 list-disc space-y-2 pl-5 text-base leading-relaxed text-muted">
              <li>Transfer size and decoded script weight</li>
              <li>Main-thread blocking time</li>
              <li>Test date, device, and connection profile for every result</li>
              <li>Raw result links when available</li>
            </ul>
          </div>
        </section>
      )
    }

    {
      hasRecorded && (
        <section aria-labelledby="recorded-benchmarks-heading">
          <h2 id="recorded-benchmarks-heading" class="sr-only">Recorded benchmarks</h2>
          <ul class="grid gap-4">
            {recorded.map((benchmark) => (
              <li>
                <BenchmarkCard
                  benchmark={benchmark}
                  href={`/benchmarks/${benchmark.data.slug}/`}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
