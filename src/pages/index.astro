---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonCard from '../components/ComparisonCard.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import ToolMark from '../components/ToolMark.astro';
import { getCollection } from 'astro:content';
import { getAllTools, getToolsByIds } from '../lib/tools';
import { getPublishedBenchmarks } from '../lib/benchmarks';
import { formatCountWord } from '../lib/site';

const FEATURED_COMPARISON_IDS = ['google-analytics-vs-plausible', 'datafast-vs-posthog'];
const RECENT_BENCHMARK_LIMIT = 3;

const allComparisons = await getCollection('comparisons');
const comparisons = FEATURED_COMPARISON_IDS.map((id) => {
  const comparison = allComparisons.find((entry) => entry.id === id);
  if (!comparison) {
    throw new Error(`Featured comparison not found: ${id}`);
  }
  return comparison;
});
const tools = await getAllTools();
const comparisonTools = await Promise.all(
  comparisons.map(async (comparison) => ({
    comparison,
    tools: await getToolsByIds(comparison.data.tools),
  })),
);

const allBenchmarks = await getPublishedBenchmarks();
const recentBenchmarks = allBenchmarks.slice(0, RECENT_BENCHMARK_LIMIT);
const hasMoreBenchmarks = allBenchmarks.length > RECENT_BENCHMARK_LIMIT;
---

<BaseLayout>
  <div class="page-shell">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__content prose-width">
        <p class="tag">Web, product &amp; revenue analytics</p>
        <h1 id="hero-heading" class="heading-xl mt-5 text-balance">
          <span class="text-gradient-primary">Compare analytics tools</span>
          <span class="text-fg"> by features and cost</span>
        </h1>
        <p class="page-intro mt-6">
          AnalyticsVS is an independent benchmark directory for web, product, and revenue analytics
          tools. We publish reference-grade comparisons, pricing calculators, and recorded script
          performance benchmarks.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/compare/" class="btn-primary w-full no-underline sm:w-auto">Browse comparisons</a>
          <a href="/calculators/pricing/" class="btn-secondary w-full no-underline sm:w-auto"
            >Pricing calculator</a
          >
        </div>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <HeroIllustration />
      </div>
    </section>

    <section class="page-section" aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="section-heading">Featured comparisons</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          comparisonTools.map(({ comparison, tools: pair }) => (
            <li>
              <ComparisonCard comparison={comparison} tools={pair} heading="h3" />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="page-section" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="section-heading">Analytics tools</h2>
      <p class="mt-2 text-muted">
        {formatCountWord(tools.length, true)} analytics tools tracked with pricing data, feature matrices, and performance
        benchmarks.
      </p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          tools.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.data.slug}/`}
                class="card-interactive flex min-h-11 items-center justify-between gap-3 px-4 py-3"
              >
                <span class="flex min-w-0 items-center gap-2.5">
                  <ToolMark tool={tool.data} size="sm" href={false} />
                  <span class="truncate font-heading font-semibold">{tool.data.name}</span>
                </span>
                <span class="shrink-0 text-gradient-primary" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      recentBenchmarks.length > 0 && (
        <section class="page-section" aria-labelledby="benchmarks-heading">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 id="benchmarks-heading" class="section-heading">
              Recent benchmarks
            </h2>
            {hasMoreBenchmarks && (
              <a href="/benchmarks/" class="text-sm font-medium no-underline hover:underline">
                View all →
              </a>
            )}
          </div>
          <ul class="mt-6 grid gap-3">
            {recentBenchmarks.map((benchmark) => (
              <li>
                <a
                  href={`/benchmarks/${benchmark.data.slug}/`}
                  class="card-interactive flex min-h-11 items-center justify-between gap-3 px-4 py-3"
                >
                  <span class="min-w-0">
                    <span class="block truncate font-heading font-semibold text-fg">
                      {benchmark.data.title}
                    </span>
                    <span class="mt-0.5 block text-sm text-muted">
                      {benchmark.data.testDate}
                      {` · ${benchmark.data.environment.device}`}
                    </span>
                  </span>
                  <span class="shrink-0 text-gradient-primary" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
