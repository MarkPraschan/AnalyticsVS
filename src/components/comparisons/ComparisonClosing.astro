---
import RelatedLinks from '../RelatedLinks.astro';
import type { ToolReviewFaq } from '../../lib/reviews';
import type { ToolReviewSource } from '../../lib/reviews/types';
import { isAffiliateOutboundUrl, tagAffiliateOutboundUrl } from '../../lib/affiliate';
import { formatDate } from '../../lib/site';

interface Props {
  faq: ToolReviewFaq[];
  sources: Array<ToolReviewSource & { toolName: string }>;
  latestReviewedOn: string;
  comparisonUpdated: string;
  relatedLinks?: Array<{ href: string; label: string }>;
}

const { faq, sources, latestReviewedOn, comparisonUpdated, relatedLinks = [] } = Astro.props;
---

{
  faq.length > 0 && (
    <section id="faq" class="mt-10">
      <h2 class="article-heading">Frequently asked questions</h2>
      <dl class="mt-6 space-y-4">
        {faq.map((item) => (
          <div class="card">
            <dt class="font-heading font-semibold text-fg">{item.question}</dt>
            <dd class="mt-2 leading-relaxed text-muted">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<RelatedLinks links={relatedLinks} />

<section id="sources" class="mt-10">
  <h2 class="article-heading">Sources & review status</h2>
  <div class="review-meta card mt-4">
    <p class="text-sm text-muted">
      Comparison updated {formatDate(comparisonUpdated)} · Tool reviews last verified{' '}
      {formatDate(latestReviewedOn)} ·{' '}
      <a href="/methodology/">How we write comparisons</a>
    </p>
    <ul class="mt-4 space-y-2 text-sm">
      {
        sources.map((source) => {
          const href = tagAffiliateOutboundUrl(source.url);
          const rel = isAffiliateOutboundUrl(href)
            ? 'noopener noreferrer sponsored'
            : 'noopener noreferrer';
          return (
          <li>
            <span class="text-muted">{source.toolName}: </span>
            <a href={href} target="_blank" rel={rel}>
              {source.label}
            </a>
            <span class="text-muted"> — checked {formatDate(source.checkedOn)}</span>
          </li>
          );
        })
      }
    </ul>
  </div>
</section>
