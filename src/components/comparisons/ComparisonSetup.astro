---
import ToolMark from '../ToolMark.astro';
import { renderReviewMarkdown } from '../../lib/markdown';
import type { ComparisonToolContext } from '../../lib/comparisons';

interface Props {
  tools: ComparisonToolContext[];
}

const { tools } = Astro.props;
---

<section id="setup" class="mt-10">
  <h2 class="article-heading">Setup & implementation</h2>
  <div class="comparison-dimension__grid mt-4">
    {
      tools.map(({ tool, review }) => (
        <div class="comparison-dimension__panel card">
          <div class="comparison-dimension__panel-header">
            <ToolMark tool={tool.data} size="sm" href={false} />
            <h3 class="font-heading font-semibold text-fg">{tool.data.name}</h3>
          </div>
          <div class="prose-content review-prose mt-3" set:html={renderReviewMarkdown(review.setupNotes)} />
        </div>
      ))
    }
  </div>
</section>
