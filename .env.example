# PostHog browser analytics
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# IndexNow — pings Bing/Yandex/etc. after deploy (runs on Vercel/CI by default)
# INDEXNOW_SUBMIT=true

# Affiliate URL overrides — use your referral links here instead of editing tool JSON.
# Format: AFFILIATE_URL_<TOOL_ID> (uppercase, hyphens become underscores)
#
# AFFILIATE_URL_PLAUSIBLE=https://plausible.io/?ref=your-id
# AFFILIATE_URL_FATHOM=https://usefathom.com/ref/your-id
# AFFILIATE_URL_DATAFAST=https://datafa.st/?via=analyticsvs
# AFFILIATE_URL_HOTJAR=https://www.hotjar.com/?ref=your-id
# AFFILIATE_URL_POSTHOG=https://posthog.com/?ref=your-id
# AFFILIATE_URL_MATOMO=https://matomo.org/?ref=your-id
