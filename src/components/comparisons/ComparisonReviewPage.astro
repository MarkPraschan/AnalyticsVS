---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ComparisonProfileHeader from '../../components/ComparisonProfileHeader.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import QuickAnswerCallout from '../../components/QuickAnswerCallout.astro';
import TryTheseToolsSection from '../../components/TryTheseToolsSection.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import BenchmarkCard from '../../components/BenchmarkCard.astro';
import ComparisonFitGrid from '../../components/comparisons/ComparisonFitGrid.astro';
import ComparisonDimensions from '../../components/comparisons/ComparisonDimensions.astro';
import ComparisonPricing from '../../components/comparisons/ComparisonPricing.astro';
import ComparisonSetup from '../../components/comparisons/ComparisonSetup.astro';
import ComparisonLimitations from '../../components/comparisons/ComparisonLimitations.astro';
import ComparisonVerdict from '../../components/comparisons/ComparisonVerdict.astro';
import ComparisonClosing from '../../components/comparisons/ComparisonClosing.astro';
import AlsoConsiderBox from '../../components/AlsoConsiderBox.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import type { CollectionEntry } from 'astro:content';
import type { ComparisonPageContext } from '../../lib/comparisons';
import { getBenchmarksForComparison } from '../../lib/comparisons';
import { getEntryUpdatedDate, getComparisonPageUpdatedDate } from '../../lib/contentDates';
import { getToolReviewEntry } from '../../lib/reviews';
import { renderReviewMarkdown } from '../../lib/markdown';
import { getToolsByIds } from '../../lib/tools';
import { SITE } from '../../lib/site';
import { buildArticleSchema, buildBreadcrumbSchema, buildFaqSchema } from '../../lib/schema';

interface Props {
  comparison: CollectionEntry<'comparisons'>;
  context: ComparisonPageContext;
}

const { comparison, context } = Astro.props;
const tools = context.tools.map(({ tool }) => tool);
const benchmarks = await getBenchmarksForComparison(comparison.data.tools);

const editorialNotes = comparison.data.editorialNotes ?? [];
const tocHeadings = [
  { depth: 2, slug: 'quick-answer', text: 'Quick answer' },
  ...editorialNotes.map((note) => ({
    depth: 2,
    slug: note.title
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, ''),
    text: note.title,
  })),
  { depth: 2, slug: 'who-should-pick', text: 'Who should pick which?' },
  { depth: 2, slug: 'feature-comparison', text: 'Feature comparison table' },
  ...(context.dimensions.length > 0
    ? [
        { depth: 2, slug: 'head-to-head', text: 'Head-to-head by topic' },
        ...context.dimensions.map((dimension) => ({
          depth: 3,
          slug: dimension.slug,
          text: dimension.title,
        })),
      ]
    : []),
  { depth: 2, slug: 'pricing', text: 'Pricing comparison' },
  { depth: 2, slug: 'setup', text: 'Setup & implementation' },
  ...(benchmarks.length > 0
    ? [{ depth: 2, slug: 'benchmarks', text: 'Performance benchmarks' }]
    : []),
  { depth: 2, slug: 'limitations', text: 'Limitations compared' },
  { depth: 2, slug: 'bottom-line', text: 'Bottom line' },
  ...((comparison.data.alsoConsider?.length ?? 0) > 0
    ? [{ depth: 2, slug: 'also-consider', text: 'Also consider' }]
    : []),
  ...(context.mergedFaq.length > 0 ? [{ depth: 2, slug: 'faq', text: 'FAQ' }] : []),
  ...((comparison.data.relatedLinks?.length ?? 0) > 0
    ? [{ depth: 2, slug: 'related-reading', text: 'Related reading' }]
    : []),
  { depth: 2, slug: 'sources', text: 'Sources & review status' },
];

const alsoConsiderTools = await getToolsByIds(
  (comparison.data.alsoConsider ?? []).map((item) => item.toolId),
);
const alsoConsiderItems = (comparison.data.alsoConsider ?? []).flatMap((item) => {
  const tool = alsoConsiderTools.find((entry) => entry.data.id === item.toolId);
  return tool
    ? [
        {
          tool,
          note: item.note,
          compareHref: item.compareHref,
          compareLabel: item.compareLabel,
        },
      ]
    : [];
});

const pageUrl = new URL(`/compare/${comparison.id}/`, SITE.url).href;
const featuredImageUrl = comparison.data.featuredImage
  ? new URL(comparison.data.featuredImage, SITE.url).href
  : undefined;
const reviewEntries = await Promise.all(
  comparison.data.tools.map((toolId) => getToolReviewEntry(toolId)),
);
const comparisonUpdated = getEntryUpdatedDate(comparison);
const updatedDate = getComparisonPageUpdatedDate(
  comparison,
  tools,
  reviewEntries.filter((entry): entry is NonNullable<typeof entry> => entry != null),
);

const schema = [
  buildArticleSchema({
    title: comparison.data.title,
    description: comparison.data.description,
    url: pageUrl,
    dateModified: updatedDate,
    image: featuredImageUrl,
    breadcrumbs: [],
    speakableCssSelector: '#quick-answer',
  }),
  buildBreadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: 'Comparisons', url: new URL('/compare/', SITE.url).href },
    { name: comparison.data.title, url: pageUrl },
  ]),
  buildFaqSchema(context.mergedFaq, {
    pageUrl,
    sectionLabel: 'full comparison',
  }),
].filter((item): item is Record<string, unknown> => item != null);
---

<ArticleLayout
  title={comparison.data.title}
  fullTitle={comparison.data.seoTitle}
  description={comparison.data.seoDescription ?? comparison.data.description}
  ogImage={comparison.data.ogImage ?? comparison.data.featuredImage}
  schema={schema}
>
  <ComparisonProfileHeader
    title={comparison.data.title}
    description={comparison.data.description}
    updatedDate={updatedDate}
    tools={tools}
    featuredImage={comparison.data.featuredImage}
    featuredImageAlt={comparison.data.featuredImageAlt}
    slot="header"
  />

  <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_240px]">
    <div class="min-w-0">
      <QuickAnswerCallout content={comparison.data.quickAnswer} pageUrl="#feature-comparison" />

      {
        editorialNotes.length > 0 && (
          <div class="mt-10 space-y-10">
            {editorialNotes.map((note) => {
              const slug = note.title
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '');
              return (
                <section id={slug} class="prose-content review-prose">
                  <h2 class="article-heading">{note.title}</h2>
                  <div class="mt-4" set:html={renderReviewMarkdown(note.content)} />
                </section>
              );
            })}
          </div>
        )
      }

      <ComparisonFitGrid tools={context.tools} />

      <section id="feature-comparison" class="mt-10">
        <h2 class="article-heading">Feature comparison table</h2>
        <div class="mt-4">
          <ComparisonTable tools={tools} />
        </div>
      </section>

      <ComparisonDimensions dimensions={context.dimensions} />
      <ComparisonPricing tools={context.tools} />
      <ComparisonSetup tools={context.tools} />

      {
        benchmarks.length > 0 && (
          <section id="benchmarks" class="mt-10">
            <h2 class="article-heading">Performance benchmarks</h2>
            <div class="mt-4 space-y-4">
              {benchmarks.map((benchmark) => (
                <BenchmarkCard benchmark={benchmark} />
              ))}
            </div>
          </section>
        )
      }

      <ComparisonLimitations tools={context.tools} />
      <ComparisonVerdict bottomLine={comparison.data.bottomLine} />
      {
        comparison.data.afterVerdict && (
          <div class="mt-6">
            <div
              class="prose-content review-prose"
              set:html={renderReviewMarkdown(comparison.data.afterVerdict)}
            />
            {/usefathom\.com\/ref\/|datafa\.st\/\?via=|invite\.contentsquare\.com\//i.test(
              comparison.data.afterVerdict,
            ) && <AffiliateDisclosure class="mt-2" />}
          </div>
        )
      }
      <AlsoConsiderBox items={alsoConsiderItems} />
      <ComparisonClosing
        faq={context.mergedFaq}
        sources={context.sources}
        latestReviewedOn={context.latestReviewedOn}
        comparisonUpdated={comparisonUpdated}
        relatedLinks={comparison.data.relatedLinks ?? []}
      />
    </div>
    <aside class="hidden lg:block">
      <TableOfContents headings={tocHeadings} />
    </aside>
  </div>

  <TryTheseToolsSection tools={tools} class="mt-12" />
</ArticleLayout>
