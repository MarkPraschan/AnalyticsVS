---
interface Props {
  summary: string;
  winner?: string | null;
  embedded?: boolean;
}

const { summary, winner, embedded = false } = Astro.props;
---

{
  embedded ? (
    <div class="mt-6 border-t border-border pt-6">
      <p class="label-mono text-gradient-secondary">Bottom line</p>
      <p class="mt-3 leading-relaxed text-fg">{summary}</p>
      {
        winner && (
          <p class="mt-3 text-sm text-muted">
            Our pick for most teams: <strong class="text-mint">{winner}</strong>
          </p>
        )
      }
    </div>
  ) : (
    <aside class="card border-gradient-secondary">
      <p class="label-mono text-gradient-secondary">Bottom line</p>
      <p class="mt-3 leading-relaxed text-fg">{summary}</p>
      {
        winner && (
          <p class="mt-3 text-sm text-muted">
            Our pick for most teams: <strong class="text-mint">{winner}</strong>
          </p>
        )
      }
    </aside>
  )
}
