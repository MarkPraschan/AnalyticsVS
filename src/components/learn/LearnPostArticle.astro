---
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleSolutionCta from '../ArticleSolutionCta.astro';
import ComparisonCard from '../ComparisonCard.astro';
import KeyTakeaways from '../KeyTakeaways.astro';
import LearnBenchmarkMatrix from '../LearnBenchmarkMatrix.astro';
import QuickAnswerCallout from '../QuickAnswerCallout.astro';
import ToolMark from '../ToolMark.astro';
import ToolShortlist from '../ToolShortlist.astro';
import RelatedLinks from '../RelatedLinks.astro';
import TableOfContents from '../TableOfContents.astro';
import AffiliateDisclosure from '../AffiliateDisclosure.astro';
import { getCollection } from 'astro:content';
import { getEntryUpdatedDate } from '../../lib/contentDates';
import { markdownHasAffiliateLinks, renderReviewMarkdown } from '../../lib/markdown';
import { getToolById, getToolsByIds, isAffiliateTool } from '../../lib/tools';
import { SITE, formatCategory, formatDate } from '../../lib/site';
import { buildArticleSchema, buildBreadcrumbSchema, buildFaqSchema } from '../../lib/schema';
import type { BenchmarkEntry } from '../../lib/benchmarks';

interface Props {
  post: CollectionEntry<'learn'>;
}

const { post } = Astro.props;
const updatedDate = getEntryUpdatedDate(post);
const pageUrl = new URL(`/learn/${post.data.slug}/`, SITE.url).href;
const featuredImageUrl = post.data.featuredImage
  ? new URL(post.data.featuredImage, SITE.url).href
  : undefined;

const comparisons = await getCollection('comparisons');
const guides = await getCollection('guides');
const benchmarks = await getCollection('benchmarks');
const allTools = await getCollection('tools');

const relatedComparisons = post.data.relatedComparisons.flatMap((id) => {
  const comparison = comparisons.find((entry) => entry.id === id);
  return comparison ? [comparison] : [];
});
const relatedGuides = post.data.relatedGuides.flatMap((slug) => {
  const guide = guides.find((entry) => entry.data.slug === slug || entry.id === slug);
  return guide ? [guide] : [];
});
const relatedTools = await getToolsByIds(post.data.relatedTools);
const relatedComparisonCards = await Promise.all(
  relatedComparisons.map(async (comparison) => ({
    comparison,
    tools: await getToolsByIds(comparison.data.tools),
  })),
);
const shortlistTools = await getToolsByIds(
  (post.data.toolShortlist ?? []).map((item) => item.toolId),
);
const toolShortlistItems = (post.data.toolShortlist ?? []).flatMap((item) => {
  const tool = shortlistTools.find((entry) => entry.data.id === item.toolId);
  return tool ? [{ tool, bestFor: item.bestFor }] : [];
});
const shortlistHeading = post.data.toolShortlistHeading ?? 'Tools to consider';
const shortlistId = 'tool-shortlist';
const heroCtaTool = post.data.heroCta
  ? await getToolById(post.data.heroCta.toolId)
  : undefined;

const matrixRows = post.data.relatedBenchmarks
  .flatMap((id) => {
    const benchmark = benchmarks.find(
      (entry) => entry.id === id || entry.data.slug === id,
    ) as BenchmarkEntry | undefined;
    if (!benchmark || benchmark.data.status !== 'recorded') return [];
    const tool = allTools.find((entry) => entry.data.id === benchmark.data.tool);
    const cookieless = benchmark.data.slug.includes('cookieless');
    const label = cookieless
      ? `${tool?.data.name ?? benchmark.data.tool} (cookieless)`
      : (tool?.data.name ?? benchmark.data.title);
    return [{ benchmark, tool, label }];
  })
  .sort(
    (a, b) =>
      (a.benchmark.data.metrics?.transferSizeBytes ?? Number.POSITIVE_INFINITY) -
      (b.benchmark.data.metrics?.transferSizeBytes ?? Number.POSITIVE_INFINITY),
  );

const tocHeadings = [
  ...(post.data.quickAnswer
    ? [{ depth: 2 as const, slug: 'quick-answer', text: 'Quick answer' }]
    : []),
  ...(post.data.keyTakeaways.length > 0
    ? [{ depth: 2 as const, slug: 'key-takeaways', text: 'Key takeaways' }]
    : []),
  ...(heroCtaTool
    ? [{ depth: 2 as const, slug: 'solution-cta', text: 'Solution' }]
    : []),
  ...(matrixRows.length > 0
    ? [{ depth: 2 as const, slug: 'performance-matrix', text: 'Performance matrix' }]
    : []),
  ...post.data.sections.map((section) => ({
    depth: 2 as const,
    slug: section.id,
    text: section.title,
  })),
  ...(toolShortlistItems.length > 0
    ? [{ depth: 2 as const, slug: shortlistId, text: shortlistHeading }]
    : []),
  ...((post.data.faq?.length ?? 0) > 0
    ? [{ depth: 2 as const, slug: 'faq', text: 'FAQ' }]
    : []),
  ...(relatedComparisons.length > 0
    ? [{ depth: 2 as const, slug: 'related-comparisons', text: 'Related comparisons' }]
    : []),
  ...(relatedGuides.length > 0
    ? [{ depth: 2 as const, slug: 'related-guides', text: 'Related guides' }]
    : []),
  ...((post.data.relatedLinks?.length ?? 0) > 0
    ? [{ depth: 2 as const, slug: 'related-reading', text: 'Related reading' }]
    : []),
  { depth: 2, slug: 'sources', text: 'Sources & review status' },
];

const schema = [
  buildArticleSchema({
    title: post.data.seoTitle ?? post.data.title,
    description: post.data.description,
    url: pageUrl,
    dateModified: updatedDate,
    datePublished: post.data.publishedOn,
    image: featuredImageUrl,
    breadcrumbs: [],
    speakableCssSelector: post.data.quickAnswer
      ? '#quick-answer'
      : `#${post.data.sections[0]?.id ?? 'sources'}`,
  }),
  buildBreadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: 'Learn', url: new URL('/learn/', SITE.url).href },
    { name: post.data.title, url: pageUrl },
  ]),
  buildFaqSchema(post.data.faq ?? [], {
    pageUrl,
    sectionLabel: 'full article',
  }),
].filter((item): item is Record<string, unknown> => item != null);

const markdownAffiliate = [
  post.data.quickAnswer,
  ...post.data.sections.map((section) => section.content),
  ...post.data.faq.map((item) => `${item.question} ${item.answer}`),
].some((block) => markdownHasAffiliateLinks(block));

const hasAffiliateCtas =
  markdownAffiliate ||
  Boolean(heroCtaTool && isAffiliateTool(heroCtaTool.data)) ||
  toolShortlistItems.some(({ tool }) => isAffiliateTool(tool.data));
---

<ArticleLayout
  title={post.data.title}
  fullTitle={post.data.seoTitle}
  description={post.data.description}
  lastUpdated={post.data.featuredImage ? undefined : updatedDate}
  ogImage={post.data.featuredImage}
  schema={schema}
>
  {
    post.data.featuredImage ? (
      <header slot="header" class="learn-hero relative mb-10 overflow-hidden rounded-2xl border-4 border-white shadow-sm">
        <img
          src={post.data.featuredImage}
          alt=""
          width="1024"
          height="571"
          class="absolute inset-0 size-full object-cover blur-xs "
          decoding="async"
          fetchpriority="high"
        />
        <div class="learn-hero__scrim rounded-none absolute inset-0" aria-hidden="true" />
        <div class="relative max-w-xl px-5 py-8 sm:px-10 sm:py-12">
          <div class="rounded-xl bg-base/95 p-5 shadow-sm sm:bg-transparent sm:p-0 sm:shadow-none">
            <p class="label-mono text-gradient-secondary">
              {formatCategory(post.data.category)} · Written by {SITE.author}
            </p>
            <h1 class="heading-lg mt-3 text-gradient-primary">{post.data.title}</h1>
            <p class="page-intro mt-4">{post.data.answerUnderTitle ?? post.data.description}</p>
            <p class="mt-4 text-sm text-muted">
              Published <time datetime={post.data.publishedOn}>{formatDate(post.data.publishedOn)}</time>
              {' · '}
              Updated <time datetime={updatedDate}>{formatDate(updatedDate)}</time>
            </p>
          </div>
        </div>
      </header>
    ) : (
      <p class="label-mono text-gradient-secondary" slot="lead-meta">
        {formatCategory(post.data.category)} · Written by {SITE.author} · Published{' '}
        {formatDate(post.data.publishedOn)}
      </p>
    )
  }

  <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_240px]">
    <div class="min-w-0">
      {
        post.data.quickAnswer && (
          <QuickAnswerCallout
            content={post.data.quickAnswer}
            pageUrl={matrixRows.length > 0 ? '#performance-matrix' : undefined}
          />
        )
      }

      <KeyTakeaways items={post.data.keyTakeaways} />

      {
        heroCtaTool && (
          <ArticleSolutionCta
            tool={heroCtaTool}
            headline={post.data.heroCta?.headline}
            note={post.data.heroCta?.note}
            label={post.data.heroCta?.label}
          />
        )
      }

      {
        hasAffiliateCtas && !heroCtaTool && (
          <AffiliateDisclosure class="mt-6" />
        )
      }

      {
        matrixRows.length > 0 && (
          <section id="performance-matrix" class="mt-10">
            <h2 class="article-heading">Performance matrix</h2>
            <p class="mt-2 text-sm text-muted">
              Live numbers from our recorded benchmarks — not estimates. Open each report for run
              ranges and environment notes.
            </p>
            <div class="mt-4">
              <LearnBenchmarkMatrix rows={matrixRows} />
            </div>
          </section>
        )
      }

      {
        post.data.sections.map((section) => (
          <section id={section.id} class="mt-10">
            <h2 class="article-heading">{section.title}</h2>
            <div class="prose-content review-prose mt-4" set:html={renderReviewMarkdown(section.content)} />
          </section>
        ))
      }

      <ToolShortlist
        items={toolShortlistItems}
        heading={shortlistHeading}
        id={shortlistId}
      />

      {
        (post.data.faq?.length ?? 0) > 0 && (
          <section id="faq" class="mt-10">
            <h2 class="article-heading">Frequently asked questions</h2>
            <dl class="mt-6 space-y-4">
              {post.data.faq.map((item) => (
                <div class="card">
                  <dt class="font-heading font-semibold text-fg">{item.question}</dt>
                  <dd class="mt-2 leading-relaxed text-muted">{item.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        relatedComparisonCards.length > 0 && (
          <section id="related-comparisons" class="mt-10">
            <h2 class="article-heading">Related comparisons</h2>
            <p class="mt-2 text-sm text-muted">
              Head-to-head pages with feature matrices, pricing context, and verdicts.
            </p>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {relatedComparisonCards.map(({ comparison, tools }) => (
                <li>
                  <ComparisonCard comparison={comparison} tools={tools} heading="h3" />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        relatedGuides.length > 0 && (
          <section id="related-guides" class="mt-10">
            <h2 class="article-heading">Related guides</h2>
            <ul class="mt-4 grid gap-3">
              {relatedGuides.map((guide) => (
                <li>
                  <a
                    href={`/learn/${guide.data.slug}/`}
                    class="card block no-underline transition hover:border-indigo/40"
                  >
                    <h3 class="font-heading text-lg font-semibold text-fg">{guide.data.title}</h3>
                    <p class="mt-1 text-sm text-muted">{guide.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        relatedTools.length > 0 && (
          <section class="mt-10">
            <h2 class="article-heading">Tools mentioned</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {relatedTools.map((tool) => (
                <li>
                  <a
                    href={`/tools/${tool.data.slug}/`}
                    class="inline-flex items-center gap-2 rounded-lg border border-border bg-white px-3 py-1.5 text-sm text-muted no-underline transition hover:border-indigo/40 hover:text-indigo"
                  >
                    <ToolMark tool={tool.data} size="sm" href={false} />
                    {tool.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <RelatedLinks links={post.data.relatedLinks ?? []} />

      <section id="sources" class="mt-10">
        <h2 class="article-heading">Sources & review status</h2>
        <div class="review-meta card mt-4">
          <p class="text-sm text-muted">
            Written by {SITE.author} · Published {formatDate(post.data.publishedOn)} · Updated{' '}
            {formatDate(updatedDate)} · <a href="/methodology/">How we measure</a> ·{' '}
            <a href="/benchmarks/">All benchmarks</a> · <a href="/learn/">More Learn articles</a>
            {hasAffiliateCtas && (
              <>
                {' · '}
                <a href="/disclosure/">Affiliate disclosure</a>
              </>
            )}
          </p>
        </div>
      </section>
    </div>
    <aside class="hidden lg:block">
      <div class="learn-sidebar sticky top-28 flex max-h-[calc(100vh-8rem)] flex-col gap-4 self-start">
        <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain">
          <TableOfContents headings={tocHeadings} sticky={false} />
        </div>
        {
          heroCtaTool && (
            <div class="shrink-0">
              <ArticleSolutionCta
                tool={heroCtaTool}
                headline={post.data.heroCta?.headline}
                note={post.data.heroCta?.note}
                label={post.data.heroCta?.label}
                compact
              />
            </div>
          )
        }
      </div>
    </aside>
  </div>
</ArticleLayout>
