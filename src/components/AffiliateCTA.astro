---
import type { ToolEntry } from '../lib/tools';
import ToolMark from './ToolMark.astro';
import VisitCTA from './VisitCTA.astro';

interface Props {
  name: string;
  url?: string;
  affiliate?: boolean;
  label?: string;
  tool?: ToolEntry['data'];
  /** Drop the inner card chrome when a parent already provides the container. */
  flush?: boolean;
}

const { name, url, affiliate = false, label = 'Visit website', tool, flush = false } = Astro.props;
---

{
  url ? (
    <div class:list={[!flush && 'card', 'flex h-full flex-col gap-4']}>
      <div class="flex min-w-0 items-center gap-3">
        {tool && <ToolMark tool={tool} size="sm" href={false} />}
        <p class="font-heading font-semibold text-fg">{name}</p>
      </div>
      <VisitCTA url={url} affiliate={affiliate} label={label} variant="card" class="mt-auto" />
    </div>
  ) : null
}
