---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import PricingTable from '../../components/PricingTable.astro';
import BenchmarkCard from '../../components/BenchmarkCard.astro';
import ToolMark from '../../components/ToolMark.astro';
import ToolProfileHeader from '../../components/ToolProfileHeader.astro';
import ComparisonCard from '../../components/ComparisonCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ToolReviewIntro from '../../components/ToolReviewIntro.astro';
import ToolReviewFit from '../../components/ToolReviewFit.astro';
import ToolReviewCapabilities from '../../components/ToolReviewCapabilities.astro';
import ToolReviewSetup from '../../components/ToolReviewSetup.astro';
import ToolReviewClosing from '../../components/ToolReviewClosing.astro';
import ToolReviewVariants from '../../components/ToolReviewVariants.astro';
import ToolFeatureChecklist from '../../components/ToolFeatureChecklist.astro';
import TryTheseToolsSection from '../../components/TryTheseToolsSection.astro';
import { validateToolReviewAccuracy } from '../../lib/reviews/validate';
import { getToolReviewEntry } from '../../lib/reviews';
import { getToolPageUpdatedDate } from '../../lib/contentDates';
import { renderReviewMarkdown } from '../../lib/markdown';
import { getAllTools, getComparisonsForTool, getBenchmarksForTool, getToolsByIds } from '../../lib/tools';
import { SITE } from '../../lib/site';
import { buildArticleSchema, buildBreadcrumbSchema, buildFaqSchema } from '../../lib/schema';
import type { ToolEntry } from '../../lib/tools';
import type { ToolReview } from '../../lib/reviews';

interface Props {
  tool: ToolEntry;
  review: ToolReview;
}

const { tool, review } = Astro.props;

validateToolReviewAccuracy(tool, review);

const reviewEntry = await getToolReviewEntry(tool.data.id);
const updatedDate = getToolPageUpdatedDate(tool, reviewEntry ?? undefined);

const comparisons = await getComparisonsForTool(tool.data.id);
const benchmarks = await getBenchmarksForTool(tool.data.id);

const uniqueToolIds = [...new Set(comparisons.flatMap((c) => c.data.tools))];
const allTools = await getAllTools();
const relatedTools = allTools.filter(
  (t) => uniqueToolIds.includes(t.data.id) && t.data.id !== tool.data.id,
);
const relatedComparisons = await Promise.all(
  comparisons.map(async (comparison) => ({
    comparison,
    tools: await getToolsByIds(comparison.data.tools),
  })),
);

const tryTheseTools = [tool, ...relatedTools.slice(0, 2)];

const tocHeadings = [
  { depth: 2, slug: 'quick-answer', text: 'Quick answer' },
  { depth: 2, slug: 'features', text: 'Features' },
  { depth: 2, slug: 'best-for', text: 'Who is it for?' },
  ...review.sections.map((s) => ({ depth: 2, slug: s.id, text: s.title })),
  ...(tool.data.variants?.length
    ? [{ depth: 2, slug: 'variants', text: 'Product variants' }]
    : []),
  { depth: 2, slug: 'pricing', text: 'Pricing' },
  { depth: 2, slug: 'setup', text: 'Setup & implementation' },
  ...(benchmarks.length > 0
    ? [{ depth: 2, slug: 'benchmarks', text: 'Performance benchmarks' }]
    : []),
  ...(comparisons.length > 0
    ? [{ depth: 2, slug: 'comparisons', text: `Comparisons featuring ${tool.data.name}` }]
    : []),
  ...(relatedTools.length > 0
    ? [{ depth: 2, slug: 'compared-with', text: 'Often compared with' }]
    : []),
  { depth: 2, slug: 'limitations', text: 'Limitations' },
  ...(review.faq.length > 0 ? [{ depth: 2, slug: 'faq', text: 'FAQ' }] : []),
  { depth: 2, slug: 'sources', text: 'Sources & review status' },
];

const pageUrl = new URL(`/tools/${tool.data.slug}/`, SITE.url).href;

const schema = [
  buildArticleSchema({
    title: `${tool.data.name} — Analytics Tool Review`,
    description: tool.data.tagline,
    url: pageUrl,
    dateModified: updatedDate,
    breadcrumbs: [],
    speakableCssSelector: '#quick-answer',
  }),
  buildBreadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: 'Tools', url: new URL('/tools/', SITE.url).href },
    { name: tool.data.name, url: pageUrl },
  ]),
  buildFaqSchema(review.faq, {
    pageUrl,
    sectionLabel: 'full review',
  }),
].filter((item): item is Record<string, unknown> => item != null);
---

<ArticleLayout title={tool.data.name} description={tool.data.tagline} schema={schema}>
  <ToolProfileHeader tool={tool.data} updatedDate={updatedDate} slot="header" />

  <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_240px]">
    <div class="min-w-0">
      <ToolReviewIntro review={review} pageUrl="#features" />

      <ToolFeatureChecklist tool={tool} reviewScope={review.reviewScope} />

      <ToolReviewFit review={review} />

      <ToolReviewCapabilities sections={review.sections} />

      <ToolReviewVariants tool={tool} />

      <section id="pricing" class="mt-10">
        <h2 class="article-heading">Pricing</h2>
        <div class="prose-content review-prose mt-4" set:html={renderReviewMarkdown(review.pricingNotes)} />
        <div class="mt-4">
          <PricingTable tool={tool} />
        </div>
        <p class="mt-4 text-sm">
          <a href="/calculators/pricing/">Use the pricing calculator</a> to compare costs at your
          traffic level.
        </p>
      </section>

      <ToolReviewSetup setupNotes={review.setupNotes} />

      {
        benchmarks.length > 0 && (
          <section id="benchmarks" class="mt-10">
            <h2 class="article-heading">Performance benchmarks</h2>
            <div class="mt-4 space-y-4">
              {benchmarks.map((benchmark) => (
                <BenchmarkCard benchmark={benchmark} />
              ))}
            </div>
          </section>
        )
      }

      {
        comparisons.length > 0 && (
          <section id="comparisons" class="mt-10">
            <h2 class="article-heading">Comparisons featuring {tool.data.name}</h2>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {relatedComparisons.map(({ comparison, tools: pair }) => (
                <li>
                  <ComparisonCard comparison={comparison} tools={pair} heading="h3" />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        relatedTools.length > 0 && (
          <section id="compared-with" class="mt-10">
            <h2 class="article-heading">Often compared with</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {relatedTools.map((related) => (
                <li>
                  <a
                    href={`/tools/${related.data.slug}/`}
                    class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface-raised px-3 py-1.5 text-sm text-muted no-underline transition hover:border-indigo/40 hover:text-indigo"
                  >
                    <ToolMark tool={related.data} size="sm" href={false} />
                    {related.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <ToolReviewClosing review={review} />
    </div>
    <aside class="hidden lg:block">
      <TableOfContents headings={tocHeadings} />
    </aside>
  </div>

  <TryTheseToolsSection tools={tryTheseTools} heading="Explore these tools" class="mt-12" />
</ArticleLayout>
