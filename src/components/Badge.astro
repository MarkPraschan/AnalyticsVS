---
interface Props {
  label: string;
  /** Colored status cue — only the dot stays chromatic. */
  dotClassName: string;
  /** Unused: chip chrome is neutral. Kept for call-site compatibility. */
  bgClassName?: string;
  /** Unused: chip chrome is neutral. Kept for call-site compatibility. */
  borderBClassName?: string;
}

const { label, dotClassName } = Astro.props;
---

<span class="attr-badge">
  <svg viewBox="0 0 6 6" aria-hidden="true" class:list={['attr-badge__dot', dotClassName]}>
    <circle r="3" cx="3" cy="3" />
  </svg>
  {label}
</span>
