---
import { isAffiliateOutboundUrl, tagAffiliateOutboundUrl } from '../lib/affiliate';
import { formatDate } from '../lib/site';

interface Props {
  updatedDate: string;
  websiteUrl?: string;
  websiteLabel?: string;
}

const { updatedDate, websiteUrl, websiteLabel } = Astro.props;
const resolvedWebsiteUrl = websiteUrl ? tagAffiliateOutboundUrl(websiteUrl) : undefined;
const websiteRel = resolvedWebsiteUrl
  ? isAffiliateOutboundUrl(resolvedWebsiteUrl)
    ? 'noopener noreferrer sponsored'
    : 'noopener noreferrer'
  : undefined;
---

<section id="sources" class="mt-10">
  <h2 class="article-heading">Sources & review status</h2>
  <div class="review-meta card mt-4">
    <p class="text-sm text-muted">
      Profile updated {formatDate(updatedDate)}
      {
        resolvedWebsiteUrl && websiteLabel && (
          <>
            {' '}
            · Pricing sourced from{' '}
            <a href={resolvedWebsiteUrl} target="_blank" rel={websiteRel}>
              {websiteLabel}
            </a>
          </>
        )
      }
      {' '}
      · <a href="/methodology/">How we review tools</a>
    </p>
  </div>
</section>
