---
import type { CollectionEntry } from 'astro:content';
import BenchmarkReport from './BenchmarkReport.astro';

interface Props {
  benchmark: CollectionEntry<'benchmarks'>;
  /** When set, wraps the main body (not the footer) in a link to the detail page. */
  href?: string;
}

const { benchmark, href } = Astro.props;
const { data } = benchmark;
const isPending = data.status === 'pending';
---

<article class="card benchmark-card">
  {
    href ? (
      <a href={href} class="benchmark-card__link block no-underline">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 class="font-heading text-xl font-semibold text-fg">{data.title}</h3>
            <p class="benchmark-card__meta mt-1 text-sm text-muted">
              {data.testDate} · {data.environment.device} · {data.environment.connection}
              {data.runStats?.runs ? ` · Avg of ${data.runStats.runs} runs` : ''}
            </p>
          </div>
          {
            !isPending && (
              <span class="benchmark-badge">Recorded by AnalyticsVS</span>
            )
          }
        </div>
        {
          isPending ? (
            <p class="mt-6 text-sm leading-relaxed text-muted">
              This benchmark is queued for controlled testing. We publish results only after recording
              real measurements on a live test page — never estimated or vendor-claimed numbers.
            </p>
          ) : (
            <div class="mt-6">
              <BenchmarkReport benchmark={benchmark} />
            </div>
          )
        }
      </a>
    ) : (
      <>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 class="font-heading text-xl font-semibold">{data.title}</h3>
            <p class="benchmark-card__meta mt-1 text-sm text-muted">
              {data.testDate} · {data.environment.device} · {data.environment.connection}
              {data.runStats?.runs ? ` · Avg of ${data.runStats.runs} runs` : ''}
            </p>
          </div>
          {
            !isPending && (
              <span class="benchmark-badge">Recorded by AnalyticsVS</span>
            )
          }
        </div>
        {
          isPending ? (
            <p class="mt-6 text-sm leading-relaxed text-muted">
              This benchmark is queued for controlled testing. We publish results only after recording
              real measurements on a live test page — never estimated or vendor-claimed numbers.
            </p>
          ) : (
            <div class="mt-6">
              <BenchmarkReport benchmark={benchmark} />
            </div>
          )
        }
      </>
    )
  }

  {
    !isPending && (
      <footer class="benchmark-card__footer">
        <a href="/methodology/">How we benchmark</a>
      </footer>
    )
  }
</article>
