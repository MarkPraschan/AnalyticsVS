---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import GuideLearnArticle from '../../components/learn/GuideLearnArticle.astro';
import LearnPostArticle from '../../components/learn/LearnPostArticle.astro';
import { getPublishedLearnPosts } from '../../lib/learn';

type Props =
  | { entryKind: 'post'; post: CollectionEntry<'learn'> }
  | { entryKind: 'guide'; guide: CollectionEntry<'guides'> };

export async function getStaticPaths() {
  const [posts, guides] = await Promise.all([
    getPublishedLearnPosts(),
    getCollection('guides'),
  ]);

  return [
    ...posts.map((post) => ({
      params: { slug: post.data.slug },
      props: { entryKind: 'post' as const, post },
    })),
    ...guides.map((guide) => ({
      params: { slug: guide.data.slug },
      props: { entryKind: 'guide' as const, guide },
    })),
  ];
}

const props = Astro.props as Props;
---

{
  props.entryKind === 'guide' ? (
    <GuideLearnArticle guide={props.guide} />
  ) : (
    <LearnPostArticle post={props.post} />
  )
}
