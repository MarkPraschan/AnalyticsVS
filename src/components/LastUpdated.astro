---
import { formatDate } from '../lib/site';

interface Props {
  date: Date | string;
}

const { date } = Astro.props;
const isoDate = typeof date === 'string' ? date : date.toISOString();
---

<p class="freshness-badge" role="note">
  <span class="freshness-badge__label">Last updated</span>
  <time datetime={isoDate} class="freshness-badge__date">{formatDate(date)}</time>
</p>
