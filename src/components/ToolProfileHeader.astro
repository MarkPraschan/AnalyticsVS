---
import ToolMark from './ToolMark.astro';
import LastUpdated from './LastUpdated.astro';
import AttributeBadges from './AttributeBadges.astro';
import VisitCTA from './VisitCTA.astro';
import { getToolVisitUrl, isAffiliateTool, type ToolEntry } from '../lib/tools';

interface Props {
  tool: ToolEntry['data'];
  updatedDate: Date | string;
}

const { tool, updatedDate } = Astro.props;
const visitUrl = getToolVisitUrl(tool);
const isAffiliate = isAffiliateTool(tool);
---

<header class="profile-header">
  <div class="flex min-w-0 gap-4 sm:gap-5">
    <div class="shrink-0 pt-0.5">
      <ToolMark tool={tool} size="lg" href={false} />
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
      <div class="min-w-0">
        <h1 class="heading-lg text-gradient-primary">{tool.name}</h1>
        <p class="page-intro mt-1.5">{tool.tagline}</p>
        <div class="profile-header__meta">
          <AttributeBadges tool={tool} />
          <LastUpdated date={updatedDate} />
        </div>
      </div>

      {visitUrl && <VisitCTA url={visitUrl} affiliate={isAffiliate} />}
    </div>
  </div>
</header>
