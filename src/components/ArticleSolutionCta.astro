---
import AffiliateCTA from './AffiliateCTA.astro';
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import { getToolVisitUrl, isAffiliateTool, type ToolEntry } from '../lib/tools';

interface Props {
  tool: ToolEntry;
  headline?: string;
  note?: string;
  label?: string;
  compact?: boolean;
}

const {
  tool,
  headline = 'Get better results, faster',
  note,
  label,
  compact = false,
} = Astro.props;

const affiliate = isAffiliateTool(tool.data);
const visitUrl = getToolVisitUrl(tool.data);
const ctaLabel = label ?? `Get started with ${tool.data.name}`;
---

<section
  id={compact ? undefined : 'solution-cta'}
  class:list={['article-solution-cta', compact && 'article-solution-cta--compact']}
>
  {
    !compact && (
      <div class="min-w-0">
        <p class="label-mono text-gradient-secondary">Solution</p>
        <h2 class="mt-2 font-heading text-xl font-semibold text-fg">{headline}</h2>
        {note && <p class="mt-2 text-sm leading-relaxed text-muted">{note}</p>}
        <p class="mt-3 text-sm text-muted">
          Read the{' '}
          <a href={`/tools/${tool.data.slug}/`}>{tool.data.name} profile</a> on AnalyticsVS, or
          open the vendor site from the button.
        </p>
      </div>
    )
  }
  <AffiliateCTA
    name={tool.data.name}
    url={visitUrl}
    affiliate={affiliate}
    label={ctaLabel}
    tool={tool.data}
    flush
  />
  {affiliate && <AffiliateDisclosure class={compact ? 'mt-2' : 'sm:col-span-2'} />}
</section>
