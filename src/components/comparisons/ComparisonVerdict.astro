---
import { renderSimpleMarkdown } from '../../lib/markdown';

interface Props {
  bottomLine: string;
}

const { bottomLine } = Astro.props;
---

<section id="bottom-line" class="mt-10">
  <h2 class="article-heading">Bottom line</h2>
  <div class="prose-content mt-4" set:html={renderSimpleMarkdown(bottomLine)} />
</section>
