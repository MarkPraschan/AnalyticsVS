---
import type { CollectionEntry } from 'astro:content';
import { getProductEditions, getToolVisitRel, getToolVisitUrl } from '../lib/tools';

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const editions = getProductEditions(tool.data);
---

{
  editions.length > 1 && (
    <section id="variants" class="mt-10">
      <h2 class="article-heading">Product variants</h2>
      <p class="mt-2 text-sm text-muted">
        {tool.data.name} ships more than one edition. The feature checklist and pricing table reflect
        the primary product.
      </p>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {
          editions.map((edition) => {
            const href = edition.isPrimary ? getToolVisitUrl(tool.data) : edition.website;
            const rel = edition.isPrimary ? getToolVisitRel(tool.data) : 'noopener noreferrer';
            return (
              <li class="card">
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <h3 class="font-heading font-semibold text-fg">{edition.name}</h3>
                  <div class="flex flex-wrap gap-2">
                    {
                      edition.isPrimary && (
                        <span class="rounded-md border border-indigo/30 bg-indigo/10 px-2 py-0.5 font-mono text-xs uppercase tracking-wider text-indigo">
                          Primary
                        </span>
                      )
                    }
                    <span class="rounded-md border border-border bg-surface-raised px-2 py-0.5 font-mono text-xs uppercase tracking-wider text-muted">
                      {edition.deployment === 'self-hosted' ? 'Self-hosted' : 'Cloud'}
                    </span>
                  </div>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-muted">{edition.summary}</p>
                <p class="mt-3 text-sm">
                  <a href={href} target="_blank" rel={rel}>
                    {edition.isPrimary ? 'Product website' : `${edition.name} details`}
                  </a>
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>
  )
}
