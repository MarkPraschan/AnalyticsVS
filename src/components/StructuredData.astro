---
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[] | null;
}

const { data } = Astro.props;

const schemas = data
  ? Array.isArray(data)
    ? data
    : [data]
  : [];
---

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
