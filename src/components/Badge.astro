---
interface Props {
  label: string;
  dotClassName: string;
  bgClassName: string;
  /** Unused — border stays neutral/light. Kept for call-site compatibility. */
  borderBClassName?: string;
}

const { label, dotClassName, bgClassName } = Astro.props;
---

<span class:list={['attr-badge', bgClassName]}>
  <svg viewBox="0 0 6 6" aria-hidden="true" class:list={['attr-badge__dot', dotClassName]}>
    <circle r="3" cx="3" cy="3" />
  </svg>
  {label}
</span>
