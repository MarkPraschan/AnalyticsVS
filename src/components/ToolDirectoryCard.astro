---
import { getToolVisitRel, getToolVisitUrl, isAffiliateTool, type ToolEntry } from '../lib/tools';
import AttributeBadges from './AttributeBadges.astro';
import Reicon from './Reicon.astro';
import ToolMark from './ToolMark.astro';

interface Props {
  tool: ToolEntry;
}

const { tool } = Astro.props;
const profileUrl = `/tools/${tool.data.slug}/`;
const visitUrl = getToolVisitUrl(tool.data);
const visitRel = getToolVisitRel(tool.data);
const isAffiliate = isAffiliateTool(tool.data);
---

<article class="directory-card">
  <div class="directory-card__body">
    <div class="flex w-full items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <h2 class="truncate font-heading text-lg font-bold leading-tight text-fg">
          <a href={profileUrl} class="text-fg no-underline hover:text-indigo-dark">
            {tool.data.name}
          </a>
        </h2>
        <div class="mt-2">
          <AttributeBadges tool={tool.data} limit={3} />
        </div>
        <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted">{tool.data.tagline}</p>
      </div>
      <ToolMark tool={tool.data} />
    </div>
  </div>
  <div class="directory-card__actions">
    <div class="flex w-0 flex-1">
      <a href={profileUrl} class="directory-card__action">
        <Reicon name="book" />
        Read more
      </a>
    </div>
    <div class="flex w-0 flex-1">
      <a
        href={visitUrl}
        class="directory-card__action"
        target="_blank"
        rel={visitRel}
        title={isAffiliate ? 'Affiliate link — we may earn a commission' : undefined}
      >
        <Reicon name="square-top-down" />
        Visit
      </a>
    </div>
  </div>
</article>
